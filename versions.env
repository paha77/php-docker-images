# Sourced by Bash in the containerized tools and CI.
PHP_BRANCHES=(82 83 84)
declare -A PHP_VERSIONS=( [82]=8.2.36 [83]=8.3.37 [84]=8.4.28 )
declare -A UBI_GENERATIONS=( [82]=9 [83]=10 [84]=10 )
# An empty package selects the pinned source build using matching official PHP headers.
declare -A XDEBUG_PACKAGES=( [82]=php-pecl-xdebug [83]='' [84]='' )
XDEBUG_SOURCE_VERSION=3.5.3
declare -A UBI_BASES=(
    [82]=registry.access.redhat.com/ubi9/php-82:latest
    [83]=registry.access.redhat.com/ubi10/php-83:latest
    [84]=registry.access.redhat.com/ubi10/php-84:latest
)
COMPOSER_BASE=composer:2.8.12
