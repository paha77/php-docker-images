# Sourced by Bash in the containerized tools and CI.
PHP_BRANCHES=(82 84)
declare -A PHP_VERSIONS=( [82]=8.2.35 [84]=8.4.27 )
declare -A UBI_GENERATIONS=( [82]=9 [84]=10 )
# The matching 8.4 Xdebug package is unavailable; review its name when Red Hat ships it.
declare -A XDEBUG_PACKAGES=( [82]=php-pecl-xdebug [84]=php8.4-pecl-xdebug )
declare -A UBI_BASES=(
    [82]=registry.access.redhat.com/ubi9/php-82:latest
    [84]=registry.access.redhat.com/ubi10/php-84:latest
)
COMPOSER_BASE=composer:2.8.12
